{
  "appId": "org.qtracker.app",
  "productName": "QTracker",
  "copyright": "Copyright © 2026 QTracker Team",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "npmRebuild": false,
  "files": [
    "src/**/*",
    "!src/bin/qbittorrent/profile/**",
    "!**/profile/**",
    "package.json"
  ],
  "asarUnpack": [
    "src/bin/qbittorrent/**",
    "!src/bin/qbittorrent/profile/**"
  ],
  "win": {
    "signtoolOptions": {
      "certificateFile": "certs/qtracker.pfx",
      "certificatePassword": "QTrackerDev2026!",
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "QTracker-Portable-${version}.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "QTracker-Setup-${version}.exe"
  }
}
